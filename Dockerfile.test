# Dockerfile.test - ProcMon builds this, runs the container, treats a non-zero exit as a test failure. pytest is the build gate.
# The model-level tests exercise the real DeepMount NER, so it is pre-downloaded here too and the run is forced offline (parity with production).
# The whole repo is copied (.dockerignore keeps .venv/.git out); the integration tests collect here because they resolve nothing at import time.
FROM python:3.12-slim

WORKDIR /app
COPY requirements-dev.txt requirements.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

RUN python -c "from transformers import AutoTokenizer, AutoModelForTokenClassification; \
    m='DeepMount00/Italian_NER_XXL'; AutoTokenizer.from_pretrained(m); \
    AutoModelForTokenClassification.from_pretrained(m)"

COPY . .

ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    PYTHONPATH=/app/src

ENTRYPOINT ["python", "-m", "pytest", "-q"]
